     if (p->hotplug_cb_registration_times++)
         return true;
 
+    if (!hotplug_track(ao)) {
+        MP_ERR(ao, "too many audio outputs to follow device changes\n");
+        p->hotplug_cb_registration_times--;
+        return false;
+    }
+
     OSStatus err = noErr;
     for (int i = 0; i < MP_ARRAY_SIZE(hotplug_properties); i++) {
         AudioObjectPropertyAddress addr = {
@@ -524,9 +624,13 @@
 {
     struct priv *p = ao->priv;
 
-    if (--p->hotplug_cb_registration_times)
+    if (p->hotplug_cb_registration_times <= 0 ||
+        --p->hotplug_cb_registration_times)
         return;
 
+    // Waits for a callback that is already running on this AO.
+    hotplug_untrack(ao);
+
     OSStatus err = noErr;
     for (int i = 0; i < MP_ARRAY_SIZE(hotplug_properties); i++) {
         AudioObjectPropertyAddress addr = {
