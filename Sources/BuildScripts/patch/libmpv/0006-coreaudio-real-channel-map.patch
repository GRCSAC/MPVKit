From: OmniPlay
Subject: [PATCH] ao_coreaudio: a real channel map, and reopen when the default output moves

Backport of upstream mpv PR #18637 (fixes #18384, #15584). The AO passed an
AudioChannelLayout as kAudioOutputUnitProperty_ChannelMap, which takes one
input channel index per device output channel. macOS 27 checks it and
returns -50 on devices with more than two channels (a 5.1 HDMI or
DisplayPort monitor), so every player fell back to ao_avfoundation, which
freezes. The AO now maps its channels 1:1 onto the device and silences the
rest, and reopens on the new device when the default output changes.
OmniPlay D25.
---
--- a/audio/out/ao_coreaudio.c
+++ b/audio/out/ao_coreaudio.c
@@ -144,7 +144,7 @@
     return CONTROL_UNKNOWN;
 }
 
-static bool init_audiounit(struct ao *ao, AudioStreamBasicDescription asbd, AudioChannelLayout *layout, size_t layout_size);
+static bool init_audiounit(struct ao *ao, AudioStreamBasicDescription asbd);
 static void init_physical_format(struct ao *ao);
 static void reinit_latency(struct ao *ao);
 static bool register_hotplug_cb(struct ao *ao);
@@ -192,13 +192,8 @@
 
     AudioStreamBasicDescription asbd;
     ca_fill_asbd(ao, &asbd);
-    size_t layout_size;
-    AudioChannelLayout *layout = ca_get_acl(ao, &layout_size);
 
-    bool r = init_audiounit(ao, asbd, layout, layout_size);
-    talloc_free(layout);
-
-    if (!r)
+    if (!init_audiounit(ao, asbd))
         goto coreaudio_error;
 
     if (!register_hotplug_cb(ao))
@@ -303,9 +298,55 @@
     talloc_free(tmp);
 }
 
-static bool init_audiounit(struct ao *ao, AudioStreamBasicDescription asbd, AudioChannelLayout *layout, size_t layout_size)
+// Backport of mpv PR #18637 (fixes #18384): kAudioOutputUnitProperty_ChannelMap
+// takes one input channel index per device output channel, not an
+// AudioChannelLayout. macOS 27 checks this and refused the old call with -50 on
+// devices with more than two channels (a 5.1 HDMI/DisplayPort monitor), so
+// every player fell back to ao_avfoundation. ca_init_chmap() already puts the
+// AO's channels in the device's order, so map them 1:1 and silence the rest.
+static void init_channel_map(struct ao *ao)
 {
+    struct priv *p = ao->priv;
     OSStatus err;
+
+    AudioStreamBasicDescription asbd;
+    uint32_t size = sizeof(asbd);
+    err = AudioUnitGetProperty(p->audio_unit, kAudioUnitProperty_StreamFormat,
+                               kAudioUnitScope_Output, 0, &asbd, &size);
+    if (!CHECK_CA_WARN("unable to retrieve device output format"))
+        return;
+
+    uint32_t device_channels = asbd.mChannelsPerFrame;
+    if (!device_channels) {
+        MP_WARN(ao, "unable to retrieve device channel count\n");
+        return;
+    }
+
+    if (ao->channels.num > device_channels) {
+        MP_WARN(ao, "more channels (%d) than the device has (%u), dropping the extra channels\n",
+                ao->channels.num, device_channels);
+    }
+
+    SInt32 *channel_map = talloc_array(NULL, SInt32, device_channels);
+    char *channel_map_str = talloc_strdup(channel_map, "");
+    for (uint32_t i = 0; i < device_channels; i++) {
+        channel_map[i] = i < ao->channels.num ? i : -1;
+        channel_map_str = talloc_asprintf_append(channel_map_str, "%s%d", i ? "," : "", channel_map[i]);
+    }
+    MP_VERBOSE(ao, "channel map: [%s]\n", channel_map_str);
+
+    err = AudioUnitSetProperty(p->audio_unit,
+                               kAudioOutputUnitProperty_ChannelMap,
+                               kAudioUnitScope_Output, 0, channel_map,
+                               device_channels * sizeof(SInt32));
+
+    talloc_free(channel_map);
+    CHECK_CA_WARN("unable to set the channel map on the audio unit");
+}
+
+static bool init_audiounit(struct ao *ao, AudioStreamBasicDescription asbd)
+{
+    OSStatus err;
     uint32_t size;
     struct priv *p = ao->priv;
 
@@ -347,13 +388,8 @@
     CHECK_CA_ERROR_L(coreaudio_error_audiounit,
                      "can't link audio unit to selected device");
 
-    err = AudioUnitSetProperty(p->audio_unit,
-                               kAudioOutputUnitProperty_ChannelMap,
-                               kAudioUnitScope_Global, 0, layout, layout_size);
+    init_channel_map(ao);
 
-    CHECK_CA_ERROR_L(coreaudio_error_audiounit,
-                     "unable to set the input channel layout on the audio unit");
-
     AURenderCallbackStruct render_cb = (AURenderCallbackStruct) {
         .inputProc       = render_cb_lpcm,
         .inputProcRefCon = ao,
@@ -554,9 +590,16 @@
     if (live) {
         struct priv *p = ao->priv;
         MP_VERBOSE(ao, "Handling potential hotplug event...\n");
+        // The unit is tied to the device it was opened on: when the default
+        // output moves (a monitor with speakers sleeps), reopen on the new one.
+        AudioDeviceID old_device = p->device;
         reinit_device(ao);
-        if (p->audio_unit)
-            reinit_latency(ao);
+        if (p->audio_unit) {
+            if (p->device != old_device)
+                ao_request_reload(ao);
+            else
+                reinit_latency(ao);
+        }
         ao_hotplug_event(ao);
     }
     mp_mutex_unlock(&hotplug_lock);
--- a/audio/out/ao_coreaudio_chmap.c
+++ b/audio/out/ao_coreaudio_chmap.c
@@ -28,6 +28,7 @@
     { kAudioChannelLabel_Left,                 MP_SPEAKER_ID_FL   },
     { kAudioChannelLabel_Right,                MP_SPEAKER_ID_FR   },
     { kAudioChannelLabel_Center,               MP_SPEAKER_ID_FC   },
+    { kAudioChannelLabel_Mono,                 MP_SPEAKER_ID_FC   },
     { kAudioChannelLabel_LFEScreen,            MP_SPEAKER_ID_LFE  },
     { kAudioChannelLabel_LeftSurround,         MP_SPEAKER_ID_BL   },
     { kAudioChannelLabel_RightSurround,        MP_SPEAKER_ID_BR   },
